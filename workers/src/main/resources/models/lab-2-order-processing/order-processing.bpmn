<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderProcessing" targetNamespace="http://workflow-automation-4.example/lab2" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="ecommerce-order-processing" name="E-commerce order processing and fulfilment" isExecutable="true">
    <bpmn:startEvent id="Start_Order" name="Order received"><bpmn:outgoing>Flow_Order_Start_Validate</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Order_Validate" name="Validate order"><bpmn:extensionElements><zeebe:taskDefinition type="lab2.validate-order" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Order_Start_Validate</bpmn:incoming><bpmn:outgoing>Flow_Order_Validate_Stock</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Order_Stock" name="Check stock and calculate total"><bpmn:extensionElements><zeebe:taskDefinition type="lab2.check-inventory-and-total" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Order_Validate_Stock</bpmn:incoming><bpmn:outgoing>Flow_Order_Stock_Gateway</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Order_Stock" name="Stock available?" default="Flow_Order_OutOfStock"><bpmn:incoming>Flow_Order_Stock_Gateway</bpmn:incoming><bpmn:outgoing>Flow_Order_Stock_Available</bpmn:outgoing><bpmn:outgoing>Flow_Order_OutOfStock</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Order_Payment" name="Process payment via REST connector"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="POST" target="method" /><zeebe:input source="=paymentApiUrl" target="url" /><zeebe:input source="={orderReference: orderReference, paymentToken: paymentToken, amount: orderTotal, simulateApiFailure: simulateApiFailure}" target="body" /><zeebe:input source="JSON" target="documentReturnFormat.choice" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /><zeebe:input source="false" target="ignoreNullValues" /><zeebe:input source="false" target="followRedirects" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultVariable" value="paymentResponse" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Order_Stock_Available</bpmn:incoming><bpmn:outgoing>Flow_Order_Payment_Gateway</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Order_Payment" name="Payment outcome" default="Flow_Order_Payment_Declined"><bpmn:incoming>Flow_Order_Payment_Gateway</bpmn:incoming><bpmn:outgoing>Flow_Order_Payment_Approved</bpmn:outgoing><bpmn:outgoing>Flow_Order_Payment_Declined</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Order_Priority" name="Determine order priority"><bpmn:extensionElements><zeebe:calledDecision decisionId="order_priority_decision" bindingType="latest" resultVariable="orderPriority" /></bpmn:extensionElements><bpmn:incoming>Flow_Order_Payment_Approved</bpmn:incoming><bpmn:outgoing>Flow_Order_Priority_Gateway</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Order_Priority" name="High value or exception?" default="Flow_Order_Fulfil"><bpmn:incoming>Flow_Order_Priority_Gateway</bpmn:incoming><bpmn:outgoing>Flow_Order_Review</bpmn:outgoing><bpmn:outgoing>Flow_Order_Fulfil</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Order_Review" name="Verify high-value order"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="order-reviewers" /></bpmn:extensionElements><bpmn:incoming>Flow_Order_Review</bpmn:incoming><bpmn:outgoing>Flow_Order_Review_Fulfil</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Order_Fulfil" name="Release order to fulfilment"><bpmn:extensionElements><zeebe:taskDefinition type="lab2.release-to-fulfilment" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Order_Fulfil</bpmn:incoming><bpmn:incoming>Flow_Order_Review_Fulfil</bpmn:incoming><bpmn:outgoing>Flow_Order_Fulfil_End</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_Order_Fulfilled" name="Fulfilment released"><bpmn:incoming>Flow_Order_Fulfil_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Order_OutOfStock" name="Out of stock"><bpmn:incoming>Flow_Order_OutOfStock</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End_Order_PaymentDeclined" name="Payment declined"><bpmn:incoming>Flow_Order_Payment_Declined</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Order_Start_Validate" sourceRef="Start_Order" targetRef="Task_Order_Validate" />
    <bpmn:sequenceFlow id="Flow_Order_Validate_Stock" sourceRef="Task_Order_Validate" targetRef="Task_Order_Stock" />
    <bpmn:sequenceFlow id="Flow_Order_Stock_Gateway" sourceRef="Task_Order_Stock" targetRef="Gateway_Order_Stock" />
    <bpmn:sequenceFlow id="Flow_Order_Stock_Available" name="Available" sourceRef="Gateway_Order_Stock" targetRef="Task_Order_Payment"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Order_OutOfStock" name="Insufficient stock" sourceRef="Gateway_Order_Stock" targetRef="End_Order_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_Order_Payment_Gateway" sourceRef="Task_Order_Payment" targetRef="Gateway_Order_Payment" />
    <bpmn:sequenceFlow id="Flow_Order_Payment_Approved" name="Approved" sourceRef="Gateway_Order_Payment" targetRef="Task_Order_Priority"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentResponse.status = "APPROVED"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Order_Payment_Declined" name="Declined / default" sourceRef="Gateway_Order_Payment" targetRef="End_Order_PaymentDeclined" />
    <bpmn:sequenceFlow id="Flow_Order_Priority_Gateway" sourceRef="Task_Order_Priority" targetRef="Gateway_Order_Priority" />
    <bpmn:sequenceFlow id="Flow_Order_Review" name="High priority" sourceRef="Gateway_Order_Priority" targetRef="Task_Order_Review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderPriority.priority = "High"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Order_Fulfil" name="Standard" sourceRef="Gateway_Order_Priority" targetRef="Task_Order_Fulfil" />
    <bpmn:sequenceFlow id="Flow_Order_Review_Fulfil" sourceRef="Task_Order_Review" targetRef="Task_Order_Fulfil" />
    <bpmn:sequenceFlow id="Flow_Order_Fulfil_End" sourceRef="Task_Order_Fulfil" targetRef="End_Order_Fulfilled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderProcessing"><bpmndi:BPMNPlane id="BPMNPlane_OrderProcessing" bpmnElement="ecommerce-order-processing">
    <bpmndi:BPMNShape id="Shape_Start_Order" bpmnElement="Start_Order"><dc:Bounds x="35" y="205" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Order_Validate" bpmnElement="Task_Order_Validate"><dc:Bounds x="105" y="183" width="145" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Order_Stock" bpmnElement="Task_Order_Stock"><dc:Bounds x="285" y="183" width="170" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Gateway_Order_Stock" bpmnElement="Gateway_Order_Stock" isMarkerVisible="true"><dc:Bounds x="490" y="198" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Order_Payment" bpmnElement="Task_Order_Payment"><dc:Bounds x="590" y="183" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Gateway_Order_Payment" bpmnElement="Gateway_Order_Payment" isMarkerVisible="true"><dc:Bounds x="805" y="198" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Order_Priority" bpmnElement="Task_Order_Priority"><dc:Bounds x="900" y="183" width="160" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Gateway_Order_Priority" bpmnElement="Gateway_Order_Priority" isMarkerVisible="true"><dc:Bounds x="1095" y="198" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Order_Review" bpmnElement="Task_Order_Review"><dc:Bounds x="1175" y="95" width="170" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Order_Fulfil" bpmnElement="Task_Order_Fulfil"><dc:Bounds x="1175" y="275" width="170" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Order_Fulfilled" bpmnElement="End_Order_Fulfilled"><dc:Bounds x="1385" y="297" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Order_OutOfStock" bpmnElement="End_Order_OutOfStock"><dc:Bounds x="590" y="370" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Order_PaymentDeclined" bpmnElement="End_Order_PaymentDeclined"><dc:Bounds x="900" y="370" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Start_Validate" bpmnElement="Flow_Order_Start_Validate"><di:waypoint x="71" y="223" /><di:waypoint x="105" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Validate_Stock" bpmnElement="Flow_Order_Validate_Stock"><di:waypoint x="250" y="223" /><di:waypoint x="285" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Stock_Gateway" bpmnElement="Flow_Order_Stock_Gateway"><di:waypoint x="455" y="223" /><di:waypoint x="490" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Stock_Available" bpmnElement="Flow_Order_Stock_Available"><di:waypoint x="540" y="223" /><di:waypoint x="590" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_OutOfStock" bpmnElement="Flow_Order_OutOfStock"><di:waypoint x="515" y="248" /><di:waypoint x="515" y="388" /><di:waypoint x="590" y="388" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Payment_Gateway" bpmnElement="Flow_Order_Payment_Gateway"><di:waypoint x="770" y="223" /><di:waypoint x="805" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Payment_Approved" bpmnElement="Flow_Order_Payment_Approved"><di:waypoint x="855" y="223" /><di:waypoint x="900" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Payment_Declined" bpmnElement="Flow_Order_Payment_Declined"><di:waypoint x="830" y="248" /><di:waypoint x="830" y="388" /><di:waypoint x="900" y="388" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Priority_Gateway" bpmnElement="Flow_Order_Priority_Gateway"><di:waypoint x="1060" y="223" /><di:waypoint x="1095" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Review" bpmnElement="Flow_Order_Review"><di:waypoint x="1120" y="198" /><di:waypoint x="1120" y="135" /><di:waypoint x="1175" y="135" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Fulfil" bpmnElement="Flow_Order_Fulfil"><di:waypoint x="1120" y="248" /><di:waypoint x="1120" y="315" /><di:waypoint x="1175" y="315" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Review_Fulfil" bpmnElement="Flow_Order_Review_Fulfil"><di:waypoint x="1260" y="175" /><di:waypoint x="1260" y="275" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Order_Fulfil_End" bpmnElement="Flow_Order_Fulfil_End"><di:waypoint x="1345" y="315" /><di:waypoint x="1385" y="315" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
