<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PatientTriageDMN" name="Patient triage decisions" namespace="http://workflow-automation-4.example/lab3" exporter="Camunda Modeler" exporterVersion="5.39.0">
  <dmn:decision id="patient_triage_decision" name="Educational patient triage decision">
    <dmn:decisionTable id="DecisionTable_PatientTriage" hitPolicy="FIRST">
      <dmn:input id="Input_ChestPain" label="Chest pain flag"><dmn:inputExpression id="InputExpression_ChestPain" typeRef="boolean"><dmn:text>chestPain</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="Input_BreathingDifficulty" label="Breathing difficulty flag"><dmn:inputExpression id="InputExpression_BreathingDifficulty" typeRef="boolean"><dmn:text>breathingDifficulty</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="Input_Duration" label="Symptom duration hours"><dmn:inputExpression id="InputExpression_Duration" typeRef="number"><dmn:text>symptomDurationHours</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:input id="Input_AgeBand" label="Age band"><dmn:inputExpression id="InputExpression_AgeBand" typeRef="string"><dmn:text>ageBand</dmn:text></dmn:inputExpression></dmn:input>
      <dmn:output id="Output_TriageCategory" label="Triage category" name="triageCategory" typeRef="string" />
      <dmn:output id="Output_ReasonCode" label="Reason code" name="reasonCode" typeRef="string" />
      <dmn:rule id="Rule_Triage_Urgent"><dmn:inputEntry id="Entry_Triage_Urgent_1"><dmn:text>true</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Urgent_2"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Urgent_3"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Urgent_4"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:outputEntry id="OutputEntry_Triage_Urgent_1"><dmn:text>"Urgent Assessment"</dmn:text></dmn:outputEntry><dmn:outputEntry id="OutputEntry_Triage_Urgent_2"><dmn:text>"CHEST_PAIN_FLAG"</dmn:text></dmn:outputEntry></dmn:rule>
      <dmn:rule id="Rule_Triage_UrgentBreathing"><dmn:inputEntry id="Entry_Triage_UrgentBreathing_1"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_UrgentBreathing_2"><dmn:text>true</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_UrgentBreathing_3"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_UrgentBreathing_4"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:outputEntry id="OutputEntry_Triage_UrgentBreathing_1"><dmn:text>"Urgent Assessment"</dmn:text></dmn:outputEntry><dmn:outputEntry id="OutputEntry_Triage_UrgentBreathing_2"><dmn:text>"BREATHING_FLAG"</dmn:text></dmn:outputEntry></dmn:rule>
      <dmn:rule id="Rule_Triage_Duration"><dmn:inputEntry id="Entry_Triage_Duration_1"><dmn:text>false</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Duration_2"><dmn:text>false</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Duration_3"><dmn:text>&gt;= 72</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Duration_4"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:outputEntry id="OutputEntry_Triage_Duration_1"><dmn:text>"Priority Review"</dmn:text></dmn:outputEntry><dmn:outputEntry id="OutputEntry_Triage_Duration_2"><dmn:text>"LONG_DURATION"</dmn:text></dmn:outputEntry></dmn:rule>
      <dmn:rule id="Rule_Triage_Senior"><dmn:inputEntry id="Entry_Triage_Senior_1"><dmn:text>false</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Senior_2"><dmn:text>false</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Senior_3"><dmn:text>&gt;= 24</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Senior_4"><dmn:text>"senior"</dmn:text></dmn:inputEntry><dmn:outputEntry id="OutputEntry_Triage_Senior_1"><dmn:text>"Priority Review"</dmn:text></dmn:outputEntry><dmn:outputEntry id="OutputEntry_Triage_Senior_2"><dmn:text>"SENIOR_LONG_DURATION"</dmn:text></dmn:outputEntry></dmn:rule>
      <dmn:rule id="Rule_Triage_Routine"><dmn:inputEntry id="Entry_Triage_Routine_1"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Routine_2"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Routine_3"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:inputEntry id="Entry_Triage_Routine_4"><dmn:text>-</dmn:text></dmn:inputEntry><dmn:outputEntry id="OutputEntry_Triage_Routine_1"><dmn:text>"Routine"</dmn:text></dmn:outputEntry><dmn:outputEntry id="OutputEntry_Triage_Routine_2"><dmn:text>"ROUTINE_ROUTE"</dmn:text></dmn:outputEntry></dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>

