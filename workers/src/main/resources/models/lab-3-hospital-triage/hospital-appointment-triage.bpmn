<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HospitalTriage" targetNamespace="http://workflow-automation-4.example/lab3" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="hospital-appointment-triage" name="Hospital appointment and patient triage" isExecutable="true">
    <bpmn:startEvent id="Start_HospitalRequest" name="Request received"><bpmn:outgoing>Flow_Hospital_Start_Validate</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Hospital_Validate" name="Validate registration"><bpmn:extensionElements><zeebe:taskDefinition type="lab3.validate-registration" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_Start_Validate</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Validate_Triage</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Hospital_Triage" name="Evaluate educational triage"><bpmn:extensionElements><zeebe:calledDecision decisionId="patient_triage_decision" bindingType="deployment" resultVariable="triageDecision" /></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_Validate_Triage</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Triage_Gateway</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Hospital_Triage" name="Triage category" default="Flow_Hospital_Routine"><bpmn:incoming>Flow_Hospital_Triage_Gateway</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Urgent</bpmn:outgoing><bpmn:outgoing>Flow_Hospital_Priority</bpmn:outgoing><bpmn:outgoing>Flow_Hospital_Routine</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Hospital_Urgent" name="Complete immediate staff assessment"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="clinical-staff-demo" /></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_Urgent</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Urgent_End</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_Hospital_Urgent" name="Urgent assessment recorded"><bpmn:incoming>Flow_Hospital_Urgent_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_Hospital_Priority" name="Review priority request"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="scheduling-staff-demo" /></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_Priority</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Priority_Schedule</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Hospital_Slots" name="Find appointment slots via REST connector" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="POST" target="method" /><zeebe:input source="=schedulingApiUrl" target="url" /><zeebe:input source="={patientReference: patientReference, appointmentPreference: appointmentPreference, simulateApiFailure: simulateApiFailure}" target="body" /><zeebe:input source="JSON" target="documentReturnFormat.choice" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /><zeebe:input source="false" target="ignoreNullValues" /><zeebe:input source="false" target="followRedirects" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultVariable" value="scheduleResponse" /><zeebe:header key="resultExpression" value="={slotsAvailable: response.body.slotsAvailable, availableSlots: response.body.availableSlots, schedulingReference: response.body.schedulingReference}" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_Routine</bpmn:incoming><bpmn:incoming>Flow_Hospital_Priority_Schedule</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Slots_Gateway</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Hospital_Slots" name="Slot available?" default="Flow_Hospital_NoSlot"><bpmn:incoming>Flow_Hospital_Slots_Gateway</bpmn:incoming><bpmn:outgoing>Flow_Hospital_SlotAvailable</bpmn:outgoing><bpmn:outgoing>Flow_Hospital_NoSlot</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Hospital_Book" name="Reserve synthetic slot"><bpmn:extensionElements><zeebe:taskDefinition type="lab3.reserve-slot" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_SlotAvailable</bpmn:incoming><bpmn:outgoing>Flow_Hospital_Book_End</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_Hospital_Booked" name="Appointment reserved"><bpmn:incoming>Flow_Hospital_Book_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="Task_Hospital_NoSlot" name="Offer alternative appointment"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="scheduling-staff-demo" /></bpmn:extensionElements><bpmn:incoming>Flow_Hospital_NoSlot</bpmn:incoming><bpmn:outgoing>Flow_Hospital_NoSlot_End</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_Hospital_NoSlot" name="Alternative offered"><bpmn:incoming>Flow_Hospital_NoSlot_End</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Hospital_Start_Validate" sourceRef="Start_HospitalRequest" targetRef="Task_Hospital_Validate" />
    <bpmn:sequenceFlow id="Flow_Hospital_Validate_Triage" sourceRef="Task_Hospital_Validate" targetRef="Task_Hospital_Triage" />
    <bpmn:sequenceFlow id="Flow_Hospital_Triage_Gateway" sourceRef="Task_Hospital_Triage" targetRef="Gateway_Hospital_Triage" />
    <bpmn:sequenceFlow id="Flow_Hospital_Urgent" name="Urgent Assessment" sourceRef="Gateway_Hospital_Triage" targetRef="Task_Hospital_Urgent"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageDecision.triageCategory = "Urgent Assessment"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Hospital_Urgent_End" sourceRef="Task_Hospital_Urgent" targetRef="End_Hospital_Urgent" />
    <bpmn:sequenceFlow id="Flow_Hospital_Priority" name="Priority Review" sourceRef="Gateway_Hospital_Triage" targetRef="Task_Hospital_Priority"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageDecision.triageCategory = "Priority Review"</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Hospital_Priority_Schedule" sourceRef="Task_Hospital_Priority" targetRef="Task_Hospital_Slots" />
    <bpmn:sequenceFlow id="Flow_Hospital_Routine" name="Routine" sourceRef="Gateway_Hospital_Triage" targetRef="Task_Hospital_Slots" />
    <bpmn:sequenceFlow id="Flow_Hospital_Slots_Gateway" sourceRef="Task_Hospital_Slots" targetRef="Gateway_Hospital_Slots" />
    <bpmn:sequenceFlow id="Flow_Hospital_SlotAvailable" name="Slot available" sourceRef="Gateway_Hospital_Slots" targetRef="Task_Hospital_Book"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=scheduleResponse.slotsAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Hospital_NoSlot" name="No slot / default" sourceRef="Gateway_Hospital_Slots" targetRef="Task_Hospital_NoSlot" />
    <bpmn:sequenceFlow id="Flow_Hospital_Book_End" sourceRef="Task_Hospital_Book" targetRef="End_Hospital_Booked" />
    <bpmn:sequenceFlow id="Flow_Hospital_NoSlot_End" sourceRef="Task_Hospital_NoSlot" targetRef="End_Hospital_NoSlot" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HospitalTriage"><bpmndi:BPMNPlane id="BPMNPlane_HospitalTriage" bpmnElement="hospital-appointment-triage">
    <bpmndi:BPMNShape id="Shape_Start_HospitalRequest" bpmnElement="Start_HospitalRequest"><dc:Bounds x="35" y="205" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_Validate" bpmnElement="Task_Hospital_Validate"><dc:Bounds x="105" y="183" width="150" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_Triage" bpmnElement="Task_Hospital_Triage"><dc:Bounds x="295" y="183" width="165" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Gateway_Hospital_Triage" bpmnElement="Gateway_Hospital_Triage" isMarkerVisible="true"><dc:Bounds x="500" y="198" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_Urgent" bpmnElement="Task_Hospital_Urgent"><dc:Bounds x="595" y="80" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Hospital_Urgent" bpmnElement="End_Hospital_Urgent"><dc:Bounds x="835" y="102" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_Priority" bpmnElement="Task_Hospital_Priority"><dc:Bounds x="595" y="185" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_Slots" bpmnElement="Task_Hospital_Slots"><dc:Bounds x="595" y="300" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Gateway_Hospital_Slots" bpmnElement="Gateway_Hospital_Slots" isMarkerVisible="true"><dc:Bounds x="840" y="315" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_Book" bpmnElement="Task_Hospital_Book"><dc:Bounds x="935" y="270" width="175" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Hospital_Booked" bpmnElement="End_Hospital_Booked"><dc:Bounds x="1150" y="292" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Task_Hospital_NoSlot" bpmnElement="Task_Hospital_NoSlot"><dc:Bounds x="935" y="390" width="175" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Hospital_NoSlot" bpmnElement="End_Hospital_NoSlot"><dc:Bounds x="1150" y="412" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Start_Validate" bpmnElement="Flow_Hospital_Start_Validate"><di:waypoint x="71" y="223" /><di:waypoint x="105" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Validate_Triage" bpmnElement="Flow_Hospital_Validate_Triage"><di:waypoint x="255" y="223" /><di:waypoint x="295" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Triage_Gateway" bpmnElement="Flow_Hospital_Triage_Gateway"><di:waypoint x="460" y="223" /><di:waypoint x="500" y="223" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Urgent" bpmnElement="Flow_Hospital_Urgent"><di:waypoint x="525" y="198" /><di:waypoint x="525" y="120" /><di:waypoint x="595" y="120" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Urgent_End" bpmnElement="Flow_Hospital_Urgent_End"><di:waypoint x="785" y="120" /><di:waypoint x="835" y="120" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Priority" bpmnElement="Flow_Hospital_Priority"><di:waypoint x="550" y="223" /><di:waypoint x="595" y="225" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Priority_Schedule" bpmnElement="Flow_Hospital_Priority_Schedule"><di:waypoint x="690" y="265" /><di:waypoint x="690" y="300" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Routine" bpmnElement="Flow_Hospital_Routine"><di:waypoint x="525" y="248" /><di:waypoint x="525" y="340" /><di:waypoint x="595" y="340" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Slots_Gateway" bpmnElement="Flow_Hospital_Slots_Gateway"><di:waypoint x="785" y="340" /><di:waypoint x="840" y="340" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_SlotAvailable" bpmnElement="Flow_Hospital_SlotAvailable"><di:waypoint x="890" y="340" /><di:waypoint x="935" y="310" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_NoSlot" bpmnElement="Flow_Hospital_NoSlot"><di:waypoint x="865" y="365" /><di:waypoint x="865" y="430" /><di:waypoint x="935" y="430" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_Book_End" bpmnElement="Flow_Hospital_Book_End"><di:waypoint x="1110" y="310" /><di:waypoint x="1150" y="310" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Flow_Hospital_NoSlot_End" bpmnElement="Flow_Hospital_NoSlot_End"><di:waypoint x="1110" y="430" /><di:waypoint x="1150" y="430" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
