# Local self-managed Camunda 8 defaults
CAMUNDA_CLIENT_MODE=self-managed
CAMUNDA_ZEEBE_GRPC_ADDRESS=http://localhost:26500
CAMUNDA_ZEEBE_REST_ADDRESS=http://localhost:8088
SERVER_PORT=8080

# For SaaS, use local untracked values instead of committing credentials:
# CAMUNDA_CLIENT_MODE=saas
# CAMUNDA_CLIENT_ID=replace-locally
# CAMUNDA_CLIENT_SECRET=replace-locally
# CAMUNDA_CLUSTER_ID=replace-locally
# CAMUNDA_REGION=replace-locally
